<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <module name="FileLength">
        <property name="max" value="300"/>
        <message key="maxLen.file" value="❌ 单文件超过 300 行。✅ FIX: 请拆分职责，提取小类或辅助组件。"/>
    </module>
    <module name="TreeWalker">
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="MethodLength">
            <property name="max" value="50"/>
            <message key="maxLen.method" value="❌ 单方法超过 50 行。✅ FIX: 请拆分为更小的私有方法或协作对象。"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="import javax\."/>
            <property name="message" value="❌ 严禁使用 javax.* 包。✅ FIX: 必须替换为 jakarta.*"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="System\.out"/>
            <property name="message" value="❌ 禁止 System.out。✅ FIX: 请使用 SLF4J Logger"/>
        </module>
        <module name="RegexpSinglelineJava">
            <property name="format" value="printStackTrace\s*\("/>
            <property name="message" value="❌ 禁止 printStackTrace。✅ FIX: 请使用 SLF4J Logger 记录异常上下文"/>
        </module>
    </module>
</module>
